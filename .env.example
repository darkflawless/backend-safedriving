# Cấu hình Database PostgreSQL
POSTGRES_DB=db_driver_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_PORT=5432

# Cấu hình EMQX Broker (MQTT)
MQTT_ENABLED=true
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_CLIENT_ID=safedriving-backend
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_DEFAULT_TOPIC=driverguard/#

# Cấu hình MinIO S3 Object Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=driverguard-media
MINIO_EXPIRY_SECONDS=3600

# Cấu hình JWT
JWT_SECRET=CHANGE_THIS_SECRET_KEY_TO_SOMETHING_LONG_AND_RANDOM_BEFORE_PRODUCTION_0123456789
JWT_EXPIRATION_MS=3600000

# Cấu hình FastAPI Face Recognition
FACE_RECOGNITION_URL=http://localhost:8000
